<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 미리보기 + 촬영(앱 전용 폴더 저장)만 사용하므로 녹화/외부저장 관련 권한은 제거.
         (원본: RECORD_AUDIO / MANAGE_EXTERNAL_STORAGE / READ·WRITE_EXTERNAL_STORAGE / FOREGROUND_SERVICE) -->
